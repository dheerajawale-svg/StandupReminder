<Window
    x:Class="StandupReminder.WinUI.TrayMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Standup Reminder Tray Menu">

    <Grid Background="Transparent">
        <Border
            MinWidth="240"
            Padding="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Spacing="2">
                <Button Click="OpenButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8A7;" />
                        <TextBlock Text="Open" />
                    </StackPanel>
                </Button>
                <Button Click="PauseResumeButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE769;" />
                        <TextBlock x:Name="PauseResumeTextBlock" Text="Pause timer" />
                    </StackPanel>
                </Button>
                <Button Click="SettingsButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
                <Rectangle
                    Height="1"
                    Margin="4,4"
                    Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Button Click="ExitButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8BB;" />
                        <TextBlock Text="Exit" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
