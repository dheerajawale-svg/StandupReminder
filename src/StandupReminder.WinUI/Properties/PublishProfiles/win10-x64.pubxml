<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\AppPackages\</AppxPackageDir>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <!--
      Self-signed dev certificate (CN=StandupReminder).
      Created once per dev machine via:
        New-SelfSignedCertificate -Type Custom -Subject "CN=StandupReminder" ...
      The cert lives in Cert:\CurrentUser\My — the .pfx is NOT in source control.
      To install on another machine: import StandupReminder-dev.pfx into
        Cert:\CurrentUser\My, then import StandupReminder-dev.cer into
        Cert:\LocalMachine\TrustedPeople before sideloading the MSIX.
    -->
    <PackageCertificateThumbprint>9D62D03B77B8E14B8457FC5B4A446D0353BDEB35</PackageCertificateThumbprint>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
  </PropertyGroup>
</Project>