<Window
    x:Class="StandupReminder.WinUI.StandUpReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Time to stand up">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBarDragRegion" Grid.Row="0" Background="Transparent" />

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Border
                x:Name="ReminderSurfaceBorder"
                CornerRadius="28"
                Background="#CC1E1E1E"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid Padding="24">
                    <Border
                        CornerRadius="28"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Opacity="0.16" />

                    <Border
                        Height="136"
                        Margin="0"
                        VerticalAlignment="Top"
                        CornerRadius="28"
                        Background="#20FFFFFF" />

                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border
                                    x:Name="ReminderAccentBadgeBorder"
                                    Width="44"
                                    Height="44"
                                    CornerRadius="22"
                                    Background="#44FFFFFF">
                                    <Viewbox Margin="10">
                                        <SymbolIcon Symbol="Clock" />
                                    </Viewbox>
                                </Border>

                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="STAND SESSION"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                        Text="Time to stand up" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                MaxWidth="430"
                                FontSize="15"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Take a break from sitting, reset your posture, and keep moving until the next sit cycle starts."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Border
                            Grid.Row="1"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="20">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="WHAT HAPPENS NEXT" />
                                <TextBlock
                                    x:Name="StandDurationTextBlock"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="18"
                            VerticalAlignment="Stretch"
                            Background="#16000000"
                            CornerRadius="20">
                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="Keep the interruption simple" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Confirm once you are up, or snooze if you need a few more minutes before switching posture."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                Grid.Column="1"
                                MinHeight="44"
                                MinWidth="152"
                                Click="OnSnoozeClicked"
                                Content="Snooze 5 min" />

                            <Button
                                x:Name="ConfirmButton"
                                Grid.Column="2"
                                MinHeight="44"
                                MinWidth="164"
                                Click="OnConfirmClicked"
                                Content="I stood up"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
