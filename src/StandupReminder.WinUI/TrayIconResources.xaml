<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">

    <XamlUICommand
        x:Key="OpenTrayCommand"
        Description="Open the dashboard"
        Label="Open" />

    <XamlUICommand
        x:Key="ShowTrayMenuCommand"
        Description="Open the tray menu"
        Label="Show tray menu" />

    <tb:TaskbarIcon
        x:Key="TrayIcon"
        LeftClickCommand="{StaticResource OpenTrayCommand}"
        NoLeftClickDelay="True"
        RightClickCommand="{StaticResource ShowTrayMenuCommand}"
        ToolTipText="Standup Reminder"
        Visibility="Visible" />
</ResourceDictionary>
