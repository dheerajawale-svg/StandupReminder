<ui:FluentWindow x:Class="StandupReminder.App.StandUpReminderWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Time to stand up"
                 Icon="Assets/reminder_17382582.ico"
                 Width="420"
                 Height="260"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowBackdropType="Acrylic"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Border Padding="24"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="Time to stand up" />

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Take a break from sitting. This reminder stays on screen until you confirm you are standing." />

            <Border Grid.Row="2"
                    Margin="0,20,0,20"
                    Padding="16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <TextBlock TextWrapping="Wrap"
                           x:Name="StandDurationTextBlock"
                           FontSize="15"
                           Text="Stand up now, stay active for the next 20 minutes, and then the app will notify you when it is time to sit again." />
            </Border>

            <Button Grid.Row="3"
                    Width="160"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="OnConfirmClicked"
                    Content="I stood up" />
        </Grid>
    </Border>
</ui:FluentWindow>
