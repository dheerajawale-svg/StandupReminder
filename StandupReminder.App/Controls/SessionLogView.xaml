<UserControl x:Class="StandupReminder.App.Controls.SessionLogView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="10"
            BorderThickness="1"
            CornerRadius="10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <ListBox ItemsSource="{Binding ElementName=Root, Path=EventLog}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="13" />
    </Border>
</UserControl>
