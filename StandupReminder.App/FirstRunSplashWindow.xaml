<Window x:Class="StandupReminder.App.FirstRunSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Standup Reminder"
        Width="560"
        Height="360"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="#FF111315"
            BorderBrush="#22282D"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="20,0,0,20" ClipToBounds="True">
                <Image x:Name="SplashImage"
                       Stretch="Fill" />
            </Border>

            <Grid Grid.Column="1" Margin="28,26,28,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="14"
                           Foreground="#FF7BA7FF"
                           Text="StandupReminder" />

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="Starting in the tray" />

                <TextBlock Grid.Row="2"
                           Margin="0,16,0,0"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="#FFD0D7DE"
                           Text="StandupReminder will keep running in the system tray and notify you when it is time to switch posture." />

                <Border Grid.Row="3"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Background="#142535"
                        CornerRadius="999">
                    <TextBlock Foreground="#FFBFD7FF"
                               FontSize="13"
                               Text="First launch setup complete" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
