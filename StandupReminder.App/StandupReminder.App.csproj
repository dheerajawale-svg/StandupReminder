<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StandupReminder</AssemblyName>
    <Product>StandupReminder</Product>
    <AssemblyTitle>StandupReminder</AssemblyTitle>
    <Description>Tray-based stand-up reminder for Windows sign-in sessions.</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\reminder_17382582.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\StandupReminder.Core\StandupReminder.Core.csproj" />
    <ProjectReference Include="..\src\StandupReminder.Persistence\StandupReminder.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\reminder_17382582.ico" />
    <Resource Include="Assets\reminder_17382582.png" />
  </ItemGroup>

</Project>
